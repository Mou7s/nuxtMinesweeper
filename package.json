{
  "name": "minesweeper",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "NODE_OPTIONS=--no-deprecation nuxt build",
    "build:cloudflare": "NODE_OPTIONS=--no-deprecation MINESWEEPER_CLOUDFLARE_BUILD=1 NITRO_PRESET=cloudflare-durable nuxt build",
    "db:generate": "bun x drizzle-kit generate",
    "db:migrate": "nuxt db migrate",
    "deploy": "bun run build:cloudflare && bun x wrangler --cwd .output deploy",
    "dev": "NODE_OPTIONS=--no-deprecation nuxt dev --host",
    "generate": "NODE_OPTIONS=--no-deprecation nuxt generate",
    "preview": "NODE_OPTIONS=--no-deprecation nuxt preview",
    "preview:cloudflare": "bun run build:cloudflare && NODE_OPTIONS=--no-deprecation bun x wrangler --cwd .output dev",
    "postinstall": "NODE_OPTIONS=--no-deprecation nuxt prepare",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node tests/run-room-smoke.mjs"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@libsql/client": "^0.17.4",
    "@nuxt/devtools": "4.0.0-alpha.4",
    "@nuxthub/core": "0.10.7",
    "@vueuse/nuxt": "^14.4.0",
    "drizzle-kit": "^0.31.10",
    "nuxt": "^4.5.1",
    "tailwindcss": "4.3.0",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "drizzle-orm": "^0.45.2",
    "vue-confetti-explosion": "^1.0.2"
  },
  "overrides": {
    "@tailwindcss/node": "4.3.0",
    "@tailwindcss/postcss": "4.3.0",
    "@tailwindcss/vite": "4.3.0",
    "tailwindcss": "4.3.0"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "sharp",
    "vue-demi",
    "workerd"
  ]
}
