# Cloudflare KV namespace id used by NuxtHub's `KV` binding.
# Create it with:
#   pnpm exec wrangler kv namespace create KV
CLOUDFLARE_KV_NAMESPACE_ID=

# World state key inside Cloudflare KV.
# Leave empty to use:
# - world-dev.json in `pnpm dev`
# - world.json in Cloudflare builds/deployments
WORLD_STATE_KEY=

# Use a long random secret in production.
# Generate one with:
#   openssl rand -base64 32
JWT_SECRET=
